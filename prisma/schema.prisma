// prisma/schema.prisma

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Admin {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Employee {
  id             String         @id @default(cuid())
  name           String
  email          String         @unique
  password       String?
  portalEnabled  Boolean        @default(false)
  phone          String?
  department     String
  position       String
  avatar         String?
  dateOfBirth    DateTime?      @db.Date
  status         EmployeeStatus @default(ACTIVE)
  joinedAt       DateTime       @default(now())
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  tasks          Task[]
  clientTasks    ClientTask[]
  attendance     Attendance[]
  leaveRequests  LeaveRequest[]
  workLinks      WorkLink[]
}

model Task {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TaskStatus @default(PENDING)
  priority    Priority   @default(MEDIUM)
  startDate   DateTime
  endDate     DateTime
  completedAt DateTime?
  employeeId  String
  employee    Employee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

model Client {
  id             String          @id @default(cuid())
  name           String
  email          String          @unique
  password       String?
  phone          String?
  company        String?
  website        String?
  notes          String?
  status         ClientStatus    @default(ACTIVE)
  portalEnabled  Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  clientTasks    ClientTask[]
  monthlyTargets MonthlyTarget[]
  invoices       Invoice[]
  workLinks      WorkLink[]
}

/// A deliverable URL (Drive / Doc / Sheet / PDF / other) submitted by an employee for a client
model WorkLink {
  id          String       @id @default(cuid())
  clientId    String
  client      Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employeeId  String?
  employee    Employee?    @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  title       String
  url         String
  linkType    WorkLinkType @default(OTHER)
  note        String?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@index([clientId])
  @@index([employeeId])
}

enum WorkLinkType {
  DRIVE
  DOC
  SHEET
  SLIDE
  PDF
  DESIGN
  VIDEO
  OTHER
}

/// Per-client delivery quota for a given month, set by an admin
model MonthlyTarget {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  year      Int
  month     Int
  target    Int      @default(0)
  note      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([clientId, year, month])
  @@index([clientId])
}

model Invoice {
  id          String        @id @default(cuid())
  clientId    String
  client      Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)
  number      String        @unique
  issueDate   DateTime      @db.Date
  dueDate     DateTime?     @db.Date
  periodYear  Int?
  periodMonth Int?
  currency    String        @default("INR")
  taxPercent  Float         @default(0)
  notes       String?
  status      InvoiceStatus @default(RAISED)
  items       InvoiceItem[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  // ── Seller snapshot (frozen at raise time so old invoices never change) ──
  sellerName    String?
  sellerAddress String?
  sellerGstin   String?
  sellerPan     String?
  sellerPhone   String?
  sellerEmail   String?
  sellerWebsite String?

  // ── Buyer / place of supply ──
  buyerGstin    String?
  buyerAddress  String?
  placeOfSupply String?

  // ── Tax treatment: SIMPLE | GST_SPLIT (CGST+SGST) | IGST ──
  taxMode     String @default("SIMPLE")
  cgstPercent Float  @default(0)
  sgstPercent Float  @default(0)
  igstPercent Float  @default(0)

  // ── Adjustments ──
  discount Float @default(0)
  roundOff Float @default(0)

  // ── Reference metadata ──
  poNumber   String?
  projectRef String?

  // ── Terms & signature ──
  paymentTerms  String?
  lateFeeNote   String?
  signatureName String?

  // ── Payment details ──
  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBranch        String?
  upiId             String?

  @@index([clientId])
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  hsnCode     String?
  quantity    Float   @default(1)
  unitPrice   Float   @default(0)

  @@index([invoiceId])
}

/// Single row holding the agency's own billing details, used to prefill invoices
model CompanyProfile {
  id      String @id @default("default")
  name    String @default("GrowthZee CRM")
  address String?
  gstin   String?
  pan     String?
  phone   String?
  email   String?
  website String?

  bankName          String?
  bankAccountName   String?
  bankAccountNumber String?
  bankIfsc          String?
  bankBranch        String?
  upiId             String?

  defaultTaxMode String @default("GST_SPLIT")
  defaultCgst    Float  @default(9)
  defaultSgst    Float  @default(9)
  defaultIgst    Float  @default(18)
  defaultCurrency String @default("INR")

  paymentTerms  String?
  lateFeeNote   String?
  signatureName String?

  updatedAt DateTime @updatedAt @default(now())
}

enum InvoiceStatus {
  DRAFT
  RAISED
  PAID
  CANCELLED
}

model ClientTask {
  id          String           @id @default(cuid())
  title       String
  description String?
  category    String?
  subCategory String?
  taskType    String?
  status      ClientTaskStatus @default(PENDING)
  priority    Priority         @default(MEDIUM)
  startDate   DateTime
  endDate     DateTime
  completedAt DateTime?
  clientId    String
  client      Client           @relation(fields: [clientId], references: [id], onDelete: Cascade)
  employeeId  String?
  employee    Employee?        @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  ON_LEAVE
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  PROSPECT
}

enum ClientTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CHANGES_REQUIRED
  OVERDUE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

model Attendance {
  id         String           @id @default(cuid())
  employeeId String
  employee   Employee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  date       DateTime         @db.Date
  status     AttendanceStatus @default(PRESENT)
  note       String?
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  @@unique([employeeId, date])
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
  WEEKEND
}

model LeaveRequest {
  id         String      @id @default(cuid())
  employeeId String
  employee   Employee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  reason     LeaveReason
  startDate  DateTime    @db.Date
  endDate    DateTime    @db.Date
  days       Int         @default(1)
  note       String?
  status     LeaveStatus @default(PENDING)
  reviewNote String?
  reviewedBy String?
  reviewedAt DateTime?
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  @@index([employeeId])
  @@index([status])
}

enum LeaveReason {
  SICK
  CASUAL
  ANNUAL
  EMERGENCY
  PERSONAL
  BEREAVEMENT
  MATERNITY
  PATERNITY
  UNPAID
  OTHER
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}
